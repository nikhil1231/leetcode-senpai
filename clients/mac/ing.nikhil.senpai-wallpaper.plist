<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs senpai-wallpaper at login and every hour. Install: see clients/README.md. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ing.nikhil.senpai-wallpaper</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-lc</string><string>"$HOME/.local/bin/senpai-wallpaper"</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>3600</integer>
  <key>StandardErrorPath</key><string>/tmp/senpai-wallpaper.log</string>
</dict>
</plist>
